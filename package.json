{
	"name": "telecode",
	"displayName": "TeleCode",
	"description": "Bridge VS Code and Telegram - control your IDE from anywhere",
	"version": "0.1.5",
	"publisher": "local",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/rongxike/telecode.git"
	},
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "telecode.sendMessage",
				"title": "TeleCode: Send Message"
			},
			{
				"command": "telecode.configure",
				"title": "TeleCode: Configure Bot Token"
			},
			{
				"command": "telecode.startBot",
				"title": "TeleCode: Start Bot"
			},
			{
				"command": "telecode.stopBot",
				"title": "TeleCode: Stop Bot"
			},
			{
				"command": "telecode.clearConversation",
				"title": "TeleCode: Clear Conversation History"
			},
			{
				"command": "telecode.sendToActiveChat",
				"title": "TeleCode: Send to Active Chat"
			},
			{
				"command": "telecode.testSend",
				"title": "TeleCode: Test Send"
			},
			{
				"command": "telecode.selectModel",
				"title": "TeleCode: Select AI Model"
			}
		],
		"configuration": {
			"title": "TeleCode",
			"properties": {
				"telecode.botToken": {
					"type": "string",
					"default": "",
					"description": "Telegram Bot API Token"
				},
				"telecode.allowedChatIds": {
					"type": "array",
					"default": [],
					"description": "Allowed Telegram Chat IDs (for security)"
				},
				"telecode.autoStart": {
					"type": "boolean",
					"default": false,
					"description": "Automatically start bot on VS Code startup"
				},
				"telecode.enableAIIntegration": {
					"type": "boolean",
					"default": true,
					"description": "Enable automatic AI responses via VS Code Language Model API"
				},
				"telecode.modelId": {
					"type": "string",
					"default": "",
					"markdownDescription": "Language model used for Telegram replies. Accepts a model `id` (e.g. `deepseek-v4-flash`), a `vendor/family` pair (e.g. `deepseek/deepseek`), or a `family` name. Leave empty to use the first available model. Run **TeleCode: Select AI Model** to pick one."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"lint": "eslint src --ext ts",
		"bump": "npm version patch --no-git-tag-version",
		"package": "npx --yes @vscode/vsce package --out telecode.vsix",
		"install:local": "npm run bump && npm run package && code --install-extension telecode.vsix --force"
	},
	"devDependencies": {
		"@types/node": "^20.x",
		"@types/vscode": "^1.85.0",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"eslint": "^10.14.0",
		"typescript": "^5.3.0"
	},
	"dependencies": {
		"node-telegram-bot-api": "^1.2.0"
	},
	"overrides": {
		"minimatch": "^11.0.4"
	}
}
